/*
  Helper 
    kad ne možemo extendat bs spacing variable
  ----------------------------------------------------------------
  for easier use of defined spacers when @extend not alowed
  usage: margin-right: $spacer-3 == @extend .mr-3; (ali bez !important što dodaje BS)
*/
