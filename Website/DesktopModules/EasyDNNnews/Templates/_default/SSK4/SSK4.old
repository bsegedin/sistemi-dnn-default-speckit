}

.u-gallery-container {
  width: 100%;
  background-color: inherit;
  border-radius: 8px;
  overflow: hidden;
}

.l-gallery-grid {
  display: grid;
}
.l-gallery-grid--mosaic {
  grid-template-columns: repeat(6, 1fr);
  grid-template-rows: repeat(2, 300px);
  gap: 1rem;
  position: relative;
}
@media only screen and (max-width: 1200px) {
  .l-gallery-grid--mosaic {
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(5, 150px);
  }
}
@media only screen and (max-width: 610px) {
  .l-gallery-grid--mosaic {
    grid-template-columns: 1fr;
    grid-template-rows: repeat(3, 300px);
  }
}
.l-gallery-grid--js-single-item {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr;
}
.l-gallery-grid .gallery-grid__item {
  cursor: pointer;
  display: block;
  height: 100%;
  width: 100%;
  max-height: 100%;
  max-width: 100%;
  -o-object-fit: cover;
     object-fit: cover;
}
.l-gallery-grid .gallery-grid__item--1 {
  grid-column: 1/5;
  grid-row: 1/3;
}
@media only screen and (max-width: 1200px) {
  .l-gallery-grid .gallery-grid__item--1 {
    grid-column: 1/5;
    grid-row: 1/4;
  }
}
@media only screen and (max-width: 610px) {
  .l-gallery-grid .gallery-grid__item--1 {
    grid-column: 1;
    grid-row: 1;
  }
}
.l-gallery-grid .gallery-grid__item--2 {
  grid-column: 5/8;
  grid-row: 1/1;
}
@media only screen and (max-width: 1200px) {
  .l-gallery-grid .gallery-grid__item--2 {
    grid-column: 1/3;
    grid-row: 4/6;
  }
}
@media only screen and (max-width: 610px) {
  .l-gallery-grid .gallery-grid__item--2 {
    grid-column: 1;
    grid-row: 2;
  }
}
.l-gallery-grid .gallery-grid__item--3 {
  grid-column: 5/8;
  grid-row: 2/2;
}
@media only screen and (max-width: 1200px) {
  .l-gallery-grid .gallery-grid__item--3 {
    grid-column: 3/5;
    grid-row: 4/6;
  }
}
@media only screen and (max-width: 610px) {
  .l-gallery-grid .gallery-grid__item--3 {
    grid-column: 1;
    grid-row: 3;
  }
}
.l-gallery-grid__item-count-number {
  width: 3.5rem;
  height: 3.5rem;
  position: absolute;
  right: 1.5%;
  bottom: 1.5%;
  background-color: #100c73;
  color: white;
  box-shadow: 0px 0px 4px 2px #212121;
  border-radius: 50%;
  border: none;
  outline: none;
  font-weight: 600;
  display: flex;
  justify-content: center;
  align-items: center;
}
@media only screen and (max-width: 900px) {
  .l-gallery-grid__item-count-number {
    width: 2.8rem;
    height: 2.8rem;
  }
}
.l-gallery-grid__item-count-number span {
  transform: translate(-20%, -10%) scale(1.4);
}
@media only screen and (max-width: 610px) {
  .l-gallery-grid__item-count-number span {
    transform: translate(-20%, 0%) scale(1.1);
  }
}

.gallery-modal {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #454545;
  z-index: 5;
}
.gallery-modal .gallery-modal__image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  height: 80%;
  width: 80%;
  z-index: 6;
}
.gallery-modal .gallery-modal__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 4rem;
  width: 4rem;
  position: absolute;
  border-radius: 50%;
  background-color: #fff;
  color: #454545;
  cursor: pointer;
  top: 50%;
  z-index: 7;
}
.gallery-modal .gallery-modal__btn--prev {
  left: 4%;
}
.gallery-modal .gallery-modal__btn--next {
  right: 4%;
}

.show-modal {
  visibility: visible;
  opacity: 1;
  z-index: 1;
}

.hide-modal {
  visibility: hidden;
  opacity: 0;
  z-index: -999;
}

