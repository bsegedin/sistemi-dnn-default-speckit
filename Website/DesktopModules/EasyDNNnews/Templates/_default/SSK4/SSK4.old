.c-documents-list__description {
  margin-bottom: 10px;
}
.c-documents-list__list {
  list-style: none;
}
.c-documents-list__item {
  display: flex;
  /*
  &, & a {
      color: $item-link-color;
  }
  &:hover 
  {
    .u-icon {
