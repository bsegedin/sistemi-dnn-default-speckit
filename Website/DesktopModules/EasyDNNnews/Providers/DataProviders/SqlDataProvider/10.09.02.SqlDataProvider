	@PortalID INT,
	@ModuleID INT,
	@UserID INT,
	@CurrentArticleID INT,
	@RecurringID INT = NULL,
	@OrderByColumnName NVARCHAR(30),
	@OrderByDirection NVARCHAR(4),
