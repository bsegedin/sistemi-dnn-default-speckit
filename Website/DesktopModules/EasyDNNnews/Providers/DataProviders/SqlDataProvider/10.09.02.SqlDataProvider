							END
							ELSE IF @DateRangeType = 2
								SET @MainFilter = @MainFilter + N' AND (ne.StartDate >= @StartDate OR (ne.StartDate < @StartDate AND ne.EndDate >= @StartDate)) '
							SET @MainFilter = @MainFilter + N'
					UNION All
					SELECT na.[ArticleID]
