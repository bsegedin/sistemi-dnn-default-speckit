justify-content: flex-end;\r\n        li {\r\n          margin-left: 0.5rem;\r\n          margin-right: 0;\r\n        }\r\n      }\r\n    }\r\n\r\n    .text-start {\r\n      .o-cta {\r\n        justify-content: flex-start;\r\n      }\r\n    }\r\n\r\n    .text-center {\r\n      .o-cta {\r\n        justify-content: center;\r\n        li {\r\n          margin-left: 0.5rem;\r\n          margin-right: 0.5rem;\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n","@import \"views/basic\";\r\n@import \"views/grid\";\r\n@import \"views/card\";\r\n@import \"views/split-view\";\r\n@import \"views/hero\";\r\n\r\n\r\n@import \"views/swiper\";\r\n@import \"views/topic-list\";\r\n@import \"views/timeline\";\r\n\r\n@import \"views/accordion\";\r\n@import \"views/tabs\";\r\n@import \"views/carousel\";\r\n@import \"views/carousel-bg\";\r\n\r\n@import \"views/tables\";\r\n\r\n\r\n:root {\r\n  --primary: #0B457F;\r\n  --main-color: #DBEDFF;\r\n  --bg-light: #f6f6f6;\r\n}\r\n\r\n.app-cb .l-item {\r\n  border: 0;\r\n  background-color: transparent;\r\n}\r\n\r\n@keyframes fade-in {\r\n  0% {\r\n    opacity: 0;\r\n  }\r\n  100% {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n.brand-color-title {\r\n  .o-title {\r\n    color: var(--primary);\r\n  }\r\n}\r\n\r\n.js-section-fade {\r\n  opacity: 0;\r\n  &.fade-in {\r\n    animation: fade-in 3s forwards;\r\n  }\r\n\r\n  &.img-no-fading {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n\r\n.item-paddingY-5 {\r\n  padding: 2.5rem 0;\r\n  @media (min-width: 1200px) {\r\n    padding: 7.5rem 0;\r\n  }\r\n}\r\n\r\n/* Klasa za vertikalno pozicioniranje texta */\r\n\r\n.bottom-align {\r\n  justify-content: flex-end;\r\n}\r\n\r\n/* Klasa za horizontalno pozicioniranje texta */\r\n\r\n.image-right .feed-item-media {\r\n  order: 2;\r\n}\r\n\r\n\r\n.feed-item-media, .feed-item-content  {\r\n  flex: 0 0 auto;\r\n  width: 100%;\r\n}\r\n\r\n@media (min-width: 1200px) {\r\n  .feed-item-media, .feed-item-content  {\r\n    flex: 0 0 auto;\r\n    width: 50%;\r\n  }\r\n}\r\n\r\n/* Feed Item */\r\n\r\n.feed-item {\r\n  height: 100%;\r\n}\r\n\r\n.feed-item picture {\r\n  width: 100%;height: 200px;\r\n  display: block;\r\n  background-color: var(--main-color);\r\n}\r\n\r\n\r\n@media (min-width: 1200px) {\r\n  .feed-item picture {\r\n    height: 100%;\r\n  }\r\n}\r\n\r\n.feed-item  .content-container-inner {\r\n    padding: 40px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    height: 100%;\r\n}\r\n\r\n@media (min-width: 1200px) {\r\n  .feed-item  .content-container-inner  {\r\n    padding: 60px;\r\n  }\r\n}\r\n\r\n\r\n\r\n// Za prebaciti\r\n\r\n.card-img-overlay {\r\n  padding: 0;\r\n  z-index: 2;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n","/* Grid */\r\n\r\n.grid-container {\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n@media (min-width: 587px) {\r\n  .grid-container {\r\n    display: grid;\r\n  }\r\n}\r\n\r\n\r\n@media (min-width: 1200px) {\r\n  .grid-container .grid-item {\r\n    height: 474px;\r\n  }\r\n}\r\n\r\n/* Case-2 */\r\n\r\n.grid-wrapper-2 .grid-container {\r\n  grid-template-rows: auto auto;\r\n  grid-template-columns: 1fr 1fr;\r\n}\r\n\r\n.grid-wrapper-2 .grid-item:nth-child(1) {\r\n  grid-column: 1 / span 2;\r\n}\r\n\r\n/* Case-3 */\r\n\r\n.grid-wrapper-3 .grid-container {\r\n  grid-template-rows: auto auto;\r\n  grid-template-columns: 1fr 1fr;\r\n}\r\n\r\n\r\n/* Case-4 */\r\n\r\n.grid-wrapper-4 .grid-container {\r\n  grid-template-columns: repeat(3, 1fr);\r\n}\r\n\r\n\r\n/* Case 1 */\r\n\r\n.grid-list-1 .grid-item:nth-child(2) .feed-item-media {order: 1;}\r\n.grid-list-1.reverse .grid-item:nth-child(1) .feed-item-media {order: 1;}\r\n.grid-list-1.reverse .grid-item:nth-child(2) .feed-item-content {order: 1;}\r\n\r\n\r\n/* Case 2 */\r\n\r\n.grid-list-2 .grid-item:nth-child(1) {\r\n  width: 100%;\r\n}\r\n\r\n.grid-list-2 .grid-item:nth-child(2),\r\n.grid-list-2 .grid-item:nth-child(3) {\r\n  width: 50%\r\n}\r\n\r\n.grid-list-2.reverse .grid-item:nth-child(1) .feed-item-media {order: 2;}\r\n.grid-list-2.reverse .grid-item:nth-child(2) .feed-item-media {order: 2;}\r\n.grid-list-2.reverse .grid-item:nth-child(3) .feed-item-media {order: 2;}\r\n\r\n/* Case 3 */\r\n\r\n.grid-list-3 .grid-item {\r\n  width: 50%;\r\n}\r\n.grid-list-3 .grid-item:nth-child(3) .feed-item-media {order: 2;}\r\n.grid-list-3 .grid-item:nth-child(4) .feed-item-media {order: 2;}\r\n\r\n.grid-list-3.reverse .grid-item:nth-child(1) .feed-item-media {order: 2;}\r\n.grid-list-3.reverse .grid-item:nth-child(2) .feed-item-media {order: 2;}\r\n\r\n.grid-list-3.reverse .grid-item:nth-child(3) .feed-item-content {order: 2;}\r\n.grid-list-3.reverse .grid-item:nth-child(4) .feed-item-content {order: 2;}\r\n\r\n\r\n\r\n/* Case 4 */\r\n\r\n.grid-list-4 {\r\n  display: grid;\r\n\r\n  @media (max-width: 576px) {\r\n    margin-right: -0.75rem !important;\r\n    margin-left: -0.75rem !important;\r\n    width: 100vw;\r\n    grid-gap: 0;\r\n  }\r\n\r\n  @media (min-width: 992px) {\r\n    grid-template-rows: 1fr 1fr;\r\n    grid-template-columns: 49% 49%;\r\n    grid-template-areas:\r\n        \"left-item right-top\"\r\n        \"left-item right-bottom\";\r\n  }\r\n  width: 100%;\r\n  min-height: 600px;\r\n  grid-gap: 24px;\r\n\r\n  .grid-item {\r\n\r\n    @media (min-width: 992px) {\r\n      &:nth-child(1) {\r\n        grid-area: left-item;\r\n      }\r\n      &:nth-child(2) {\r\n        grid-area: right-top;\r\n      }\r\n      &:nth-child(3) {\r\n        grid-area: right-bottom;\r\n      }\r\n    }\r\n\r\n    .feed-item {\r\n      position: relative;\r\n      &-media {\r\n        position: relative;\r\n        width: 100%;\r\n        height: 100%;\r\n      }\r\n\r\n      &-content {\r\n        position: absolute;\r\n        top: 0;\r\n        width: 100%;\r\n      }\r\n    }\r\n    \r\n  }\r\n\r\n}\r\n\r\n// Grid List 3\r\n\r\n.grid-list-3 {\r\n  .grid-item {\r\n    width: 100%;\r\n    @media (min-width: 992px) {\r\n      width: 50%;\r\n    }\r\n    &:nth-child(3),\r\n    &:nth-child(4) {\r\n\r\n      .l-item {\r\n        &__media {\r\n          @media (min-width: 992px) {\r\n            order: 2 !important;\r\n\r\n          }\r\n        }\r\n        &__body {\r\n          @media (min-width: 992px) {\r\n            order: 1 !important;  \r\n          }\r\n        }\r\n      }\r\n\r\n      \r\n      .reverse-item {\r\n        .l-item {\r\n          &__media {\r\n            order: 1 !important;\r\n          }\r\n\r\n          &__body {\r\n            order: 2 !important;\r\n\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n    .reverse-item {\r\n      background-color: white;\r\n      .l-item {\r\n        &__media {\r\n          order: 2 !important;\r\n        }\r\n\r\n        &__body {\r\n          order: 1 !important;\r\n\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n// Grid List 2\r\n\r\n.grid-list-2 {\r\n  .grid-item {\r\n    &:first-child {\r\n      background-color: #f6f6f6;\r\n    }\r\n    &:nth-child(2),\r\n    &:nth-child(3) {\r\n      width: 100%;\r\n      @media (min-width: 992px) {\r\n        width: 50%;\r\n      }\r\n    }\r\n  }\r\n}\r\n","// Modifier\r\n\r\n.list-no-padding {\r\n  .row {\r\n    margin: 0;\r\n    > div {\r\n      padding: 0;\r\n    }\r\n  }\r\n}\r\n\r\n.l-view--card {\r\n  border-radius: 0;\r\n  margin-left: 0;\r\n  margin-right: 0;\r\n  &.dark-bg {\r\n    padding: 0.75rem;\r\n  }\r\n\r\n  .o-body {\r\n    p {\r\n      margin-bottom: 0;\r\n    }\r\n  }\r\n\r\n  .card {\r\n    border-radius: 0;\r\n    background-color: transparent;\r\n  }\r\n\r\n  .l-item__body {\r\n     margin-top: 1rem;\r\n     @media (min-width: 768px) {\r\n      margin-top: 2rem;\r\n    }\r\n\r\n     &.card-img-overlay {\r\n      margin-top: 0;\r\n     }\r\n  }\r\n\r\n  &.hero-small {\r\n\r\n    .l-item__media {\r\n      margin: 0;\r\n    }\r\n\r\n    .l-item__body {\r\n      margin-top: 0;\r\n      width: 100%;\r\n      padding-right: calc(var(--bs-gutter-x)* 0.5);\r\n      padding-left: calc(var(--bs-gutter-x)* 0.5);\r\n      margin-right: auto;\r\n      margin-left: auto;\r\n      top: 50%;bottom: auto;\r\n      left: 50%;\r\n      transform: translate(-50%, -50%);\r\n      @media (min-width: 576px) {\r\n        max-width: 540px;\r\n      }\r\n      @media (min-width: 768px) {\r\n        max-width: 720px;\r\n      }\r\n      @media (min-width: 992px) {\r\n        max-width: 960px;\r\n      }\r\n\r\n      @media (min-width: 1200px) {\r\n        max-width: 1140px;\r\n        display: flex;\r\n        justify-content: start;\r\n\r\n        .l-item__body-content {\r\n          padding: inherit !important;\r\n        }\r\n      }\r\n\r\n      @media (min-width: 1400px) {\r\n        max-width: 1400px;\r\n        display: flex;\r\n        justify-content: start;\r\n      }\r\n\r\n      &-content {\r\n        padding-left: 0 !important;\r\n        padding-right: 0 !important;\r\n\r\n        .o-title {\r\n          margin: 0;\r\n        }\r\n\r\n \r\n      }\r\n\r\n    }\r\n  }\r\n\r\n    &.delimiter {\r\n\r\n      .card {\r\n        margin: 0;\r\n      }\r\n\r\n        .l-item__media {\r\n          picture img {\r\n            min-height: 450px;\r\n            @media (min-width: 992px) {\r\n              height: 550px;\r\n              object-position: bottom;\r\n          }\r\n        }\r\n\r\n        .o-image {\r\n          margin-bottom: 0;\r\n        }\r\n      }\r\n\r\n      ul.o-cta {\r\n        li {\r\n          margin-left: 1.5rem;\r\n          margin-right: 0;\r\n        }\r\n      }\r\n\r\n    \r\n      .l-item__body {\r\n        --bs-gutter-x: 1.5rem;\r\n        --bs-gutter-y: 0;\r\n        width: 100%;\r\n        padding-right: calc(var(--bs-gutter-x)* 0.5);\r\n        padding-left: calc(var(--bs-gutter-x)* 0.5);\r\n        margin-right: auto;\r\n        margin-left: auto;\r\n        margin-top: 0;\r\n\r\n        @media (min-width: 576px) {\r\n          max-width: 540px;\r\n        }\r\n        @media (min-width: 768px) {\r\n          max-width: 720px;\r\n        }\r\n        @media (min-width: 992px) {\r\n          max-width: 960px;\r\n          top: 50%;\r\n          left: 50%;\r\n          transform: translate(-50%, -50%);\r\n        }\r\n\r\n        @media (min-width: 1200px) {\r\n          max-width: 1140px;\r\n          display: flex;\r\n          justify-content: end;\r\n          align-items: center;\r\n\r\n          .l-item__body-content {\r\n            width: 33%;\r\n            padding: inherit !important;\r\n          }\r\n        }\r\n\r\n        .l-item__body-content {\r\n          @media (max-width: 992px) {\r\n            justify-content: center !important;\r\n          }\r\n        }\r\n\r\n        @media (min-width: 1400px) {\r\n          max-width: 1400px;\r\n        }\r\n\r\n        &-content {\r\n          padding-left: 0 !important;\r\n          padding-right: 0 !important;\r\n        }\r\n\r\n        &.text-start {\r\n          justify-content: flex-start;\r\n        }\r\n\r\n      }\r\n  }\r\n\r\n  // Grid List 1\r\n\r\n  &.grid-list-1 {\r\n    .grid-item {\r\n      @media (max-width: 992px) {\r\n        flex: 0 0 auto;\r\n        width: 100%;\r\n        padding-bottom: 1.5rem;\r\n\r\n      }\r\n    }\r\n  }\r\n  \r\n\r\n  // Grid List 2\r\n\r\n  &.grid-list-2 {\r\n    .grid-item {\r\n      flex: 0 0 auto;\r\n      width: 100%;\r\n      @media (min-width: 992px) {\r\n        width: 50%;\r\n        padding-bottom: 1.5rem;\r\n      }\r\n      &:nth-child(1) {\r\n        flex: 0 0 auto;\r\n        width: 100%;\r\n      }\r\n    }\r\n  }\r\n\r\n  // Grid List 3\r\n\r\n  &.grid-list-3 {\r\n    .grid-item {\r\n      flex: 0 0 auto;\r\n      width: 100%;\r\n      @media (min-width: 992px) {\r\n        width: 50%;\r\n      }\r\n      &:nth-child(1), &:nth-child(2) {\r\n        padding-bottom: 1.5rem;\r\n      }\r\n    }\r\n  }\r\n\r\n\r\n  // Grid List 4\r\n\r\n  &.grid-list-4 {\r\n    .grid-item {\r\n      padding: 0;\r\n      > div {\r\n        height: 100%;\r\n      }\r\n\r\n      .card,\r\n      .l-item__media {\r\n        height: 100%;\r\n        margin-bottom: 0;\r\n      }\r\n    }\r\n  }\r\n\r\n  .grid-item {\r\n    flex: 1 0 0%;\r\n  }\r\n\r\n  img {\r\n    width: 100%;\r\n  }\r\n\r\n  .text-end {\r\n    .o-cta {\r\n      justify-content: end;\r\n    }\r\n  }\r\n\r\n}\r\n\r\n\r\n// Appear Text\r\n\r\n.card {\r\n  position: relative;\r\n  //cursor: pointer;\r\n  &.overlay-body__text {\r\n    cursor: pointer;\r\n    .js-show {\r\n      background-color: rgba(0, 0, 0, 0.9);\r\n    }\r\n  }\r\n\r\n  .l-item__body-content {\r\n    transition: background-color 1s ease;\r\n    @media (max-width: 992px) {\r\n      padding: 0 1rem;\r\n    }\r\n\r\n    .o-description {\r\n      max-height: 0;\r\n      opacity: 0;\r\n      transition: max-height 1s ease, opacity .5s ease;\r\n    }\r\n  }\r\n\r\n  .js-close-overlay {\r\n    display: none;\r\n    position: absolute;\r\n    right: 2rem;\r\n    top: 2rem;\r\n    svg {\r\n      fill: white;\r\n      width: 35px;height: 35px;\r\n    }\r\n  }\r\n\r\n  .l-item__body-content {\r\n    &.js-show {\r\n      .o-description {\r\n        max-height: 20rem;\r\n        opacity: 1\r\n      }\r\n\r\n      .js-close-overlay {\r\n        display: block;\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n\r\n","\r\n.app-cb {\r\n\r\n  .l-view--split {\r\n\r\n    .l-item {\r\n      margin: 0;\r\n\r\n\r\n      &.img-auto-height {\r\n        picture {\r\n          img {\r\n            height: auto;\r\n            min-height: auto;\r\n          }\r\n        }\r\n      }\r\n\r\n      > div {\r\n        padding: 0;\r\n      }\r\n      &__body {\r\n        &-content {\r\n          padding: 1.75rem 2.75rem 2.75rem;\r\n          @media (min-width: 992px) {\r\n            padding: 3.75rem 3.75rem;\r\n          }\r\n        }\r\n  \r\n      }\r\n    }\r\n\r\n\r\n    .o-body {\r\n      margin-bottom: 2rem;\r\n    }\r\n\r\n  }\r\n\r\n  // CARD //\r\n\r\n  .l-view--card {\r\n    .card {\r\n      border: 0;\r\n      background-color: transparent;\r\n      //padding-right: 24px;\r\n\r\n    }\r\n\r\n    .card-img-overlay {\r\n      .l-item__body-content {\r\n        padding: 1.75rem 3.75rem 2.75rem;\r\n        @media (min-width: 992px) {\r\n          padding: 3rem;\r\n        }\r\n      }\r\n    }\r\n\r\n    .o-image {\r\n      position: relative;\r\n      &__caption {\r\n        position: absolute;\r\n        bottom: 0;left: 0;\r\n      }\r\n    }\r\n\r\n\r\n  }\r\n\r\n  ul.o-cta {\r\n    list-style-type: none;\r\n    padding: 0;\r\n  }\r\n\r\n\r\n  .l-item {\r\n\r\n    /*Fading Gradients */\r\n\r\n    &.gradient-bottom,\r\n    &.gradient-top {\r\n      .o-image {\r\n        position: relative;\r\n        &::before {\r\n          content: \"\";\r\n          position: absolute;\r\n          width: 100%;height: 100%;\r\n          z-index: 1;\r\n        }\r\n      }\r\n    }\r\n\r\n    &.gradient-bottom {\r\n      .o-image {\r\n        &::before {\r\n          background: linear-gradient(to top,rgba(0, 0, 0, 0.85),transparent 40%);\r\n        }\r\n      }\r\n    }\r\n\r\n    &.gradient-top {\r\n      .o-image {\r\n        &::before {\r\n          background: linear-gradient(to bottom,rgba(0, 0, 0, 0.85),transparent 40%);\r\n        }\r\n      }\r\n    }\r\n\r\n    // Content Align\r\n\r\n    &.content-bottom,\r\n    &.content-top {\r\n      .l-item__body-content {\r\n        display: flex;\r\n        flex-direction: column;\r\n        height: 100%;\r\n      }\r\n    }\r\n\r\n    &.content-bottom {\r\n      .l-item__body-content {\r\n        justify-content: end;\r\n      }\r\n    }\r\n\r\n    &.content-top {\r\n      .l-item__body-content {\r\n        justify-content: start;\r\n      }\r\n    }\r\n\r\n    &__media {\r\n      figure,\r\n      picture {\r\n        display: block;\r\n        height: 100%;\r\n        overflow: hidden;\r\n        img {\r\n          object-fit: cover;\r\n          height: 100%;\r\n          min-height: 420px;\r\n          @media (min-width: 992px) {\r\n            min-height: auto;\r\n          }\r\n        }\r\n      }\r\n\r\n    }\r\n\r\n    .o-cta {\r\n      display: flex;\r\n      flex-wrap: wrap;\r\n      li {\r\n        margin-right: 1.5rem;\r\n        margin-bottom: 1.5rem;\r\n      }\r\n\r\n    }\r\n\r\n  }\r\n}\r\n\r\n\r\n\r\n.l-view--split {\r\n  \r\n  &.grid-list {\r\n    .grid-item {\r\n      padding: 0;\r\n      > .row {\r\n        margin: 0;\r\n        height: 100%;\r\n      }\r\n    }\r\n\r\n    .l-item {\r\n      > div {\r\n        padding: 0;\r\n      }\r\n    }\r\n\r\n    img {\r\n      width: 100%;\r\n    }\r\n  }\r\n\r\n \r\n  // Grid List 2\r\n\r\n  &.grid-list-2 {\r\n    .grid-item {\r\n      &:nth-child(2),\r\n      &:nth-child(3) {\r\n        width: 100%;\r\n        @media (min-width: 992px) {\r\n          width: 50%;\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n\r\n  .l-item.bg-white {\r\n    border: 5px solid #f6f6f6;\r\n  }\r\n\r\n\r\n  .o-image {\r\n    &__caption {\r\n      font-size: 14px;\r\n      padding-left: 0;\r\n    }\r\n    img {\r\n      width: 100%;\r\n    }\r\n  }\r\n\r\n}\r\n\r\n\r\n.bg-dark {\r\n  .l-item__body-content, .o-image__caption {\r\n    color: white !important;\r\n  }\r\n}\r\n",".l-view--hero {\r\n  position: relative;\r\n  &.jumbotron {\r\n    &::after {\r\n      @media (max-width: 992px) {\r\n        content: \"\";\r\n        width: 100%;height: 100%;\r\n        background-color: rgba(0,0,0,0.5);\r\n        display: block;position: absolute;\r\n        left: 0;top: 0;\r\n      }\r\n    }\r\n  }\r\n  .ratio {\r\n    &::before {\r\n      @media (max-width: 992px) {\r\n          padding-top: 80% !important;\r\n      }\r\n    }\r\n  }\r\n\r\n\r\n  .jumbotron-image {\r\n    background-position: center center;\r\n    background-repeat: no-repeat;\r\n    background-size: cover;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .l-item__body {\r\n    display: flex;\r\n    align-items: center;\r\n    height: 100%;\r\n  }\r\n\r\n  .o-title {\r\n    position: relative;\r\n    z-index: 9;\r\n    @media (max-width: 992px) {\r\n      text-align: center;\r\n    }\r\n  }\r\n  \r\n}\r\n\r\n",".l-view--swiper {\r\n\r\n  // .swiper-wrapper {\r\n  // //   justify-content: center;\r\n  // // }\r\n\r\n\r\n  &.img-no-fading {\r\n    .swiper-slide {\r\n      opacity: 1;\r\n    }\r\n  }\r\n\r\n  .swiper-slide {\r\n    position: relative;\r\n    width: 80%;\r\n    margin-right: .5rem;\r\n    margin-left: .5rem;\r\n    opacity: .3;\r\n    transition: opacity 0.3s ease-in;\r\n\r\n    @media (min-width: 1200px) {\r\n      margin-right: calc(var(--bs-gutter-x)* 0.5);\r\n      margin-left: calc(var(--bs-gutter-x)* 0.5);\r\n      width: 50%;\r\n    }\r\n    .swiper-caption {\r\n      padding: 1.75rem;\r\n      position: absolute;\r\n      display: flex;\r\n      flex-direction: column;\r\n      align-items: center;\r\n      color: white;\r\n      z-index: 9;\r\n      @media (max-width: 576px) {\r\n        text-align: center !important;\r\n      }\r\n      @media (min-width: 1200px) {\r\n        padding: 3.75rem;\r\n      }\r\n    }\r\n\r\n    img {\r\n      height: 400px;\r\n      object-fit: cover;\r\n      @media (min-width: 576px) {\r\n        height: 600px;\r\n      }\r\n      @media (min-width: 1200px) {\r\n        height: auto;\r\n      }\r\n    }\r\n\r\n    &.swiper-slide-fully-visible {\r\n      opacity: 1;\r\n    }\r\n\r\n  }\r\n\r\n  // Content Align \r\n\r\n  // Bottom\r\n\r\n  .content-bottom {\r\n    .swiper-caption {\r\n      top: auto;\r\n      bottom: 0;\r\n    }\r\n  }\r\n\r\n  // Center\r\n\r\n  .content-center {\r\n    .swiper-caption {\r\n      justify-content: center;\r\n    }\r\n  }\r\n\r\n  // Top\r\n\r\n  .content-top {\r\n    .swiper-caption {\r\n      top: 0;\r\n      bottom: auto;\r\n    }\r\n  }\r\n\r\n  \r\n  .text-end {\r\n    .o-kicker, .o-title, .o-body, .o-cta  {\r\n      justify-content: flex-end;\r\n      display: flex;\r\n      width: 100%;\r\n    }\r\n  }\r\n\r\n  .text-start {\r\n    .o-kicker, .o-title, .o-body, .o-cta {\r\n      justify-content: flex-start;\r\n      display: flex;\r\n      width: 100%;\r\n    }\r\n  }\r\n\r\n  .text-center {\r\n    .o-kicker, .o-title, .o-body, .o-cta {\r\n      justify-content: center;\r\n      display: flex;\r\n      width: 100%;\r\n    }\r\n  }\r\n}\r\n\r\n.swiper {\r\n  .swiper-pagination {\r\n    &-bullet {\r\n      width: 14px;height: 14px;\r\n      background-color: var(--main-color);\r\n      opacity: 1;\r\n      &.swiper-pagination-bullet-active {\r\n        background-color: var(--primary);\r\n        border-color: var(--primary);\r\n      }\r\n    }\r\n  }\r\n\r\n  .swiper-button-next,\r\n  .swiper-button-prev {\r\n    color: var(--primary);\r\n  }\r\n}\r\n\r\n\r\n",".l-view--topiclist {\r\n  .topic-header {\r\n    display: none;\r\n    @media (min-width: 992px) {\r\n      display: block;\r\n    }\r\n  }\r\n\r\n  .topic-list {\r\n    position: relative;\r\n    overflow: hidden;\r\n    @media (min-width: 992px) {\r\n      color: white;\r\n    }\r\n\r\n    &__content {\r\n      padding-top: 3rem;\r\n      padding-bottom: 3rem;\r\n\r\n      @media (min-width: 992px) {\r\n        position: absolute;\r\n        top: 0;bottom: 0;\r\n        left: 0;right: 0;\r\n      }\r\n      \r\n      @media (min-width: 1200px) {\r\n        padding-top: 8rem;\r\n        padding-bottom: 8rem;\r\n      }\r\n      \r\n      position: relative;\r\n      display: flex;\r\n      flex-direction: column;\r\n      justify-content: space-between;\r\n    }\r\n\r\n    .topic-list-item__inner {\r\n      padding-right: 1rem;\r\n      @media (min-width: 1200px) {\r\n        padding-right: 5rem;\r\n      }\r\n    }\r\n  \r\n    .topic-list__media {\r\n      img {\r\n        object-fit: cover;\r\n      }\r\n    }\r\n  \r\n    .topic-item-image {\r\n      width: 60px;\r\n      margin-bottom: 1.125rem;\r\n      img {\r\n        filter: brightness(0) invert(1);\r\n      }\r\n    }\r\n\r\n    .l-item__body {\r\n      @media (max-width: 768px) {\r\n        text-align: center !important;\r\n      }\r\n    }\r\n    \r\n  }\r\n}\r\n",":root {\r\n\r\n  --blue-light: #B3D1E4;\r\n  --blue-primary: #0A457F;\r\n}\r\n\r\n\r\n/* Global */\r\n\r\n.timeline {\r\n  position: relative;\r\n  @media (min-width: 991.98px) {\r\n    padding: 10rem 0;\r\n  }\r\n}\r\n\r\n.timeline-content {\r\n  display: flex;\r\n  @media (max-width: 991.98px) {\r\n    flex-direction: column;\r\n  }\r\n\r\n  .timeline-article {\r\n    position: relative;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    @media (max-width: 991.98px) {\r\n      margin-bottom: 2rem;\r\n    }\r\n\r\n    @media (min-width: 991.98px) {\r\n      width: 16.6666%;\r\n      transform: translate(0, -35.4%);\r\n      flex-direction: column;\r\n    }\r\n  }\r\n}\r\n\r\n\r\n.timeline .timeline-center-line {\r\n  position: absolute;\r\n  width: 100%;height: 5px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  background: var(--blue-light);\r\n  @media (max-width: 991.98px) {\r\n    display: none;\r\n  }\r\n}\r\n\r\n.timeline .timeline-center-line::before {\r\n  content: \"\";\r\n  width: 12px;height: 12px;\r\n  border-radius: 50%;\r\n  display: block;\r\n  top: 50%;left: 0;\r\n  transform: translateY(-50%);\r\n  background: var(--blue-light);\r\n  position: absolute;\r\n}\r\n\r\n.timeline .timeline-center-line::after {\r\n  content: \"\";\r\n  width: 12px;height: 12px;\r\n  border-radius: 50%;\r\n  display: block;\r\n  top: 50%;right: 0;\r\n  transform: translateY(-50%);\r\n  background: var(--blue-light);\r\n  position: absolute;\r\n}\r\n\r\n.timeline-article .timeline-article-date h2 {\r\n  line-height: 1;\r\n  margin: 0;\r\n}\r\n\r\n.timeline-content .timeline-article img {\r\n  width: 100%;height: 120px;\r\n  object-fit: cover;\r\n}\r\n\r\n.timeline-content .timeline-article .content  {\r\n  padding: 1rem;\r\n}\r\n\r\n.timeline-content .timeline-article .content p {\r\n  margin: 0;\r\n}\r\n\r\n.timeline-content .timeline-article::before {\r\n  content: \"\";\r\n  position: absolute;\r\n  border: 2px dashed var(--blue-primary);\r\n  @media (max-width: 991.98px) {\r\n    width: 85%;\r\n  }\r\n  @media (min-width: 991.98px) {\r\n    bottom: 65px;\r\n    height: 58%;\r\n  }\r\n}\r\n\r\n.timeline-content .timeline-article::after {\r\n  position: absolute;\r\n  width: 26px;height: 26px;\r\n  border-radius: 50%;\r\n  background: var(--blue-primary);\r\n  border: 4px solid white;\r\n  @media (min-width: 576.98px) {\r\n    content: \"\";\r\n  }\r\n  @media (max-width: 991.98px) {\r\n    right: 14%;\r\n  }\r\n  @media (min-width: 991.98px) {\r\n    bottom: 60px;\r\n  }\r\n}\r\n\r\n\r\n/* Odd */\r\n\r\n.timeline-article:nth-child(odd) .timeline-article-date {\r\n  order: 2;\r\n  @media (min-width: 991.98px) {\r\n    padding-top: 8rem;\r\n  }\r\n}\r\n\r\n/* Even */\r\n\r\n.timeline-content .timeline-article:nth-child(even) {\r\n  @media (min-width: 991.98px) {\r\n    transform: translate(0, 35%);\r\n  }\r\n}\r\n\r\n.timeline-content .timeline-article:nth-child(even)::after {\r\n  position: absolute;\r\n  width: 26px;height: 26px;\r\n  border-radius: 50%;\r\n  background: var(--blue-primary);\r\n  border: 4px solid white;\r\n  @media (min-width: 576.98px) {\r\n    content: \"\";\r\n  }\r\n  @media (max-width: 991.98px) {\r\n    left: 14%;\r\n  }\r\n  @media (min-width: 991.98px) {\r\n    top: 60px;\r\n  }\r\n}\r\n\r\n.timeline-content .timeline-article:nth-child(even)::before {\r\n  @media (max-width: 991.98px) {\r\n    right: 0;\r\n  }\r\n  @media (min-width: 991.98px) {\r\n    top: 65px;\r\n  }\r\n}\r\n\r\n.timeline-article:nth-child(even) .timeline-article-date {\r\n  @media (min-width: 991.98px) {\r\n    padding-bottom: 8rem;\r\n  }\r\n}\r\n\r\n.timeline-article .timeline-article-date {\r\n  position: relative;\r\n  font-family: \"changan uni type\";\r\n  @media (max-width: 991.98px) {\r\n    background-color: white;\r\n  }\r\n\r\n}\r\n\r\n.timeline-article .timeline-article-card {\r\n  position: relative;\r\n  width: 235px;\r\n  @media (min-width: 768px) {\r\n    width: 280px;\r\n  }\r\n  background-color: #f8f8f8;\r\n  box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.10);\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n}\r\n",":root {\r\n  --primary: #0B457F;\r\n  --default: #E6E6E6;\r\n  --default-active: #F6F6F6;\r\n}\r\n\r\n.l-view--accordion {\r\n\r\n  h1, h2, h3, h4, h5 {\r\n    line-height: .5;\r\n  }\r\n\r\n  // Warranty \r\n  \r\n  &.warranty {\r\n    background-color: white;\r\n    .accordion-item button {\r\n      //padding-left: 20px\r\n    }\r\n\r\n    .accordion-item .accordion-caption table thead th:first-child {\r\n      padding-left: 1rem;\r\n      width: auto;\r\n      @media (min-width: 576px) {\r\n        padding-left: 2rem;\r\n      }\r\n\r\n\r\n    }\r\n\r\n    .accordion-item .accordion-caption table thead th {\r\n      padding-left: 0;\r\n    }\r\n\r\n    .accordion-item .accordion-caption table tbody tr td {\r\n      padding-left: 0;\r\n    }\r\n\r\n    .accordion-item .accordion-caption table tbody tr td:first-child {\r\n      padding-left: 1rem;\r\n      width: auto;\r\n      @media (min-width: 576px) {\r\n        padding-left: 2rem;\r\n      }\r\n    }\r\n  }\r\n\r\n  // Secondary Layout \r\n\r\n  &.secondary-layout {\r\n    .accordion-item {\r\n      button {\r\n        background-color: white;\r\n        border-radius: 0 !important;\r\n        border-bottom: 4px solid var(--default);\r\n        color: var(--primary);\r\n        @media (min-width: 1200px) {\r\n          padding-left: 2rem;\r\n        }\r\n  \r\n        &:focus {\r\n          box-shadow: none;\r\n        }\r\n      }\r\n    }\r\n\r\n    .accordion-caption {\r\n      .o-title {\r\n        display: block;\r\n        padding: var(--bs-accordion-btn-padding-y) var(--bs-accordion-btn-padding-x);\r\n        @media (min-width: 1200px) {\r\n          padding-left: 2rem;\r\n        }  \r\n      }\r\n\r\n      .o-body {\r\n        .o-title {\r\n          display: block;\r\n\r\n        }\r\n      }\r\n\r\n      .o-title {\r\n        display: none;\r\n      }\r\n\r\n      table {\r\n        margin-bottom: 0;\r\n        thead {\r\n          tr {\r\n            @media (max-width: 768px) {\r\n              th {\r\n                font-size: .875rem;\r\n              }\r\n            }\r\n          }\r\n          th {\r\n            background-color: var(--main-color);\r\n            padding: var(--bs-accordion-btn-padding-y) var(--bs-accordion-btn-padding-x);\r\n            font-size: 32px;\r\n            line-height: 38.4px;\r\n            font-weight: 500;\r\n            color: var(--primary);\r\n            border-bottom: 0;\r\n\r\n            @media (min-width: 1200px) {\r\n              padding-left: 8rem;\r\n            }\r\n            &:first-child {\r\n              @media (min-width: 1200px) {\r\n                width: 80%;\r\n              } \r\n            }\r\n          }\r\n        }\r\n\r\n        tbody {\r\n          tr {\r\n            td {\r\n              background-color: white;\r\n              border-bottom: 1px solid var(--default-active);\r\n              padding-right: 3rem;\r\n              text-align: right;\r\n              color: var(--primary);\r\n              @media (max-width: 768px) {\r\n                font-size: 16px;\r\n              } \r\n              &:first-child {\r\n                text-align: left;\r\n                border-right: 1px solid white;\r\n                color: inherit;\r\n                border-right: 0;\r\n\r\n                @media (min-width: 1200px) {\r\n                  padding-left: 8rem;\r\n                  width: 80%;\r\n                } \r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n  }\r\n\r\n  .accordion-header {\r\n    margin-bottom: 2px;\r\n    .o-title {\r\n      margin: 0;\r\n      font-size: 24px;\r\n      line-height: 1;\r\n    }\r\n  }\r\n\r\n  .accordion-item {\r\n    border: 0;\r\n    margin-bottom: 2px;\r\n    button {\r\n      background-color: var(--default);\r\n      border-radius: 0 !important;\r\n      color: var(--primary);\r\n      @media (min-width: 1200px) {\r\n        padding-left: 2rem;\r\n      }\r\n\r\n      &:focus {\r\n        box-shadow: none;\r\n      }\r\n    }\r\n\r\n    .accordion-caption {\r\n      .o-title {\r\n        display: block;\r\n        padding: var(--bs-accordion-btn-padding-y) var(--bs-accordion-btn-padding-x);\r\n        @media (min-width: 1200px) {\r\n          padding-left: 2rem;\r\n        }  \r\n      }\r\n\r\n      .o-body {\r\n        .o-title {\r\n          display: block;\r\n\r\n        }\r\n      }\r\n\r\n      .o-title {\r\n        display: none;\r\n      }\r\n\r\n      table {\r\n        margin-bottom: 0;\r\n        thead {\r\n          tr {\r\n            @media (max-width: 768px) {\r\n              th {\r\n                font-size: 1rem;\r\n              }\r\n            }\r\n          }\r\n          th {\r\n            background-color: var(--default-active);\r\n            padding: var(--bs-accordion-btn-padding-y) var(--bs-accordion-btn-padding-x);\r\n            font-family: \"changan uni type\";\r\n            text-rendering: optimizeLegibility;\r\n            -webkit-font-smoothing: antialiased;\r\n            font-size: 20px;\r\n            line-height: 38.4px;\r\n            font-weight: 500;\r\n            color: var(--primary);\r\n            border-bottom: 0;\r\n\r\n            @media (min-width: 1200px) {\r\n              padding-left: 2rem;\r\n            }\r\n            &:first-child {\r\n              @media (min-width: 1200px) {\r\n                width: 80%;\r\n              } \r\n            }\r\n          }\r\n        }\r\n\r\n        tbody {\r\n          tr {\r\n            td {\r\n              border-bottom: 2px solid var(--default-active);\r\n              padding-left: 2rem;\r\n              padding-right: 1rem;\r\n              text-align: right;\r\n              @media (min-width: 576px) {\r\n                padding-right: 3rem;\r\n              } \r\n\r\n              @media (max-width: 768px) {\r\n                font-size: 16px;\r\n                padding-left: 1rem;\r\n\r\n              } \r\n              &:first-child {\r\n                text-align: left;\r\n                border-right: 1px solid white;\r\n                color: inherit;\r\n                border-right: 0;\r\n\r\n                @media (min-width: 1200px) {\r\n                  padding-left: 2rem;\r\n                  width: 80%;\r\n                } \r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n\r\n    }\r\n\r\n  }\r\n}\r\n\r\n\r\n\r\n .l-view--accordion .accordion-item button[aria-expanded=\"true\"]::after {\r\n   content: url(/images/accordion-arrow-down.svg);\r\n   width: 40px;\r\n   height: 40px;\r\n   background-image: none;\r\n   transform: rotate(0);\r\n   //transform: none;\r\n }\r\n\r\n .l-view--accordion .accordion-item button[aria-expanded=\"false\"]::after {\r\n  content: url(/images/plus-sharp.svg);\r\n  width: 20px;\r\n  height: 20px;\r\n  background-image: none;\r\n}\r\n\r\n\r\n",".l-view--tabs {\r\n  .nav-tabs {\r\n\r\n    .nav-link {\r\n      border: 0;border-radius: 0;\r\n      background-color: var(--main-color);\r\n      cursor: pointer;\r\n\r\n      &.active {\r\n        background-color: var(--primary);\r\n        .o-title {\r\n          color: white;\r\n        }\r\n      }\r\n    }\r\n\r\n    .o-title {\r\n      font-size: 1.25rem;\r\n      font-weight: 500 !important;\r\n      margin: 0;\r\n    }\r\n  }\r\n\r\n  .o-image,\r\n  .o-video {\r\n    margin-bottom: 2rem;\r\n  }\r\n\r\n  .o-cta {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    li {\r\n      margin-right: 0.5rem;\r\n      margin-bottom: 0.5rem;\r\n    }\r\n  }\r\n\r\n  .text-end {\r\n    .o-cta {\r\n      justify-content: flex-end;\r\n      li {\r\n        margin-left: 0.5rem;\r\n        margin-right: 0;\r\n      }\r\n    }\r\n  }\r\n\r\n  .text-start {\r\n    .o-cta {\r\n      justify-content: flex-start;\r\n    }\r\n  }\r\n\r\n  .text-center {\r\n    .o-cta {\r\n      justify-content: center;\r\n      li {\r\n        margin-left: 0.5rem;\r\n        margin-right: 0.5rem;\r\n      }\r\n    }\r\n  }\r\n\r\n  .tab-content {\r\n    padding: 2rem 0;\r\n  }\r\n}\r\n",".l-view--carousel {\r\n\r\n  table {\r\n    border: 0;\r\n    tbody {\r\n      text-align: center;\r\n      h3 {\r\n        margin: 0;\r\n        line-height: 1;\r\n      }\r\n      tr {\r\n        &:last-child  {\r\n          font-size: 1rem;\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  .tmp-button-align {\r\n    .carousel-caption {\r\n      @media (min-width: 992px) {\r\n          display: flex;\r\n          align-items: center;\r\n\r\n      }\r\n      .o-body {\r\n        flex: 1 0 0%;\r\n      }\r\n    }\r\n  }\r\n\r\n  &.test {\r\n    margin-top: -4rem;\r\n    .o-title {\r\n      display: none;\r\n    }\r\n  }\r\n\r\n  // Mobile \r\n  @media (max-width: 992px) {\r\n    .carousel-item {\r\n      height: 90vh;\r\n      img {\r\n        height: 100% !important;\r\n        object-fit: cover;\r\n      }\r\n\r\n      .o-title {\r\n        font-size: 2rem;\r\n        line-height: 2.375rem;\r\n      }\r\n\r\n      .o-body {\r\n        font-size: 1.325rem;\r\n        line-height: normal;\r\n\r\n      }\r\n    }\r\n  }\r\n\r\n  .o-kicker {\r\n    text-transform: inherit;\r\n  }\r\n\r\n  .gradient-top,\r\n  .gradient-bottom {\r\n    &::before {\r\n      content: \"\";\r\n      position: absolute;\r\n      width: 100%;\r\n      height: 100%;\r\n      z-index: 1;\r\n    }\r\n  }\r\n\r\n  .gradient-bottom {\r\n    &::before {\r\n      background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent 40%);\r\n    }\r\n  }\r\n\r\n  .gradient-top {\r\n    &::before {\r\n      background: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent 40%);\r\n    }\r\n  }\r\n\r\n  .carousel-caption {\r\n    left: 0;right: 0;\r\n    padding-top: 10rem;padding-bottom: 5rem;\r\n    z-index: 9;\r\n\r\n    @media (max-width: 992px) {\r\n      padding-top: 6rem;\r\n    }\r\n\r\n    &.text-center {\r\n      .o-cta {\r\n        justify-content: center;\r\n      }\r\n    }\r\n\r\n    &.text-end {\r\n      .o-title, .o-body, .o-kicker {\r\n        @media (max-width: 992px) {\r\n          text-align: left;\r\n        }\r\n      }\r\n\r\n      .o-cta {\r\n        justify-content: end;\r\n        @media (max-width: 992px) {\r\n          justify-content: flex-start;\r\n        }\r\n      }\r\n    }\r\n  }\r\n\r\n  .content-top {\r\n    .carousel-caption {\r\n      top: 0;\r\n      bottom: auto;\r\n    }\r\n  }\r\n\r\n  .o-body {\r\n    font-size: 28px;\r\n    line-height: 42px;\r\n  }\r\n\r\n  .o-cta {\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    padding: 30px 0;\r\n\r\n    li {\r\n      margin-right: 1.5rem;\r\n      margin-bottom: 1.5rem;\r\n    }\r\n  }\r\n\r\n}\r\n\r\n.gradient-bottom,\r\n.gradient-top {\r\n  &::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    z-index: 1;\r\n  }\r\n}\r\n\r\n.gradient-top {\r\n  &::before {\r\n    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.85), transparent 40%);\r\n  }\r\n}\r\n\r\n.gradient-bottom {\r\n  &::before {\r\n    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent 40%);\r\n  }\r\n}\r\n",".l-carusel-bg {\r\n  position: relative;\r\n  padding: 5rem 0;\r\n  overflow: hidden;\r\n\r\n  .bg-container {\r\n    position: relative;\r\n    max-width: 57%;\r\n    margin: auto;\r\n    z-index: 9;\r\n  }\r\n\r\n  .carousel-item {\r\n    height: auto !important;\r\n    > div {\r\n      z-index: 99 !important;\r\n    }\r\n    img {\r\n      height: auto !important;\r\n    }\r\n  }\r\n\r\n  .carousel-control-prev {\r\n    @media (max-width: 992px) {\r\n        margin-left: -80px;\r\n    }\r\n  }\r\n\r\n  .carousel-control-next {\r\n    @media (max-width: 992px) {\r\n      margin-right: -80px;\r\n    }\r\n  }\r\n\r\n  .relative-image {\r\n    position: absolute;\r\n    top: 0;bottom: 0;\r\n    width: 100%;\r\n    margin: auto;\r\n    img {\r\n      width: 100%;\r\n      position: absolute;\r\n      top: 50%;\r\n      left: 50%;\r\n      transform: translate(-50%, -50%);\r\n    }\r\n  }\r\n}\r\n",".warranty-table {\r\n\r\n\r\n  .table {\r\n\r\n\r\n    > :not(caption) > * > * {\r\n      padding: 0.5rem 1.5rem;\r\n    }\r\n\r\n\r\n    // Head\r\n    thead {\r\n      th {\r\n        background-color: var(--main-color);\r\n        color: var(--primary);\r\n        border-right: 1px solid white;\r\n        border-bottom: 0;\r\n        width: 33%;\r\n      }\r\n    }\r\n  }\r\n\r\n  // Body \r\n\r\n  tbody {\r\n    tr {\r\n      td {\r\n        border-bottom: 1px solid var(--main-color);\r\n      }\r\n    }\r\n  }\r\n\r\n\r\n  .o-body ul {\r\n    list-style-type: disc;\r\n    padding-left: 2rem;\r\n  }\r\n\r\n}\r\n"],"names":[],"sourceRoot":""}