{
  "name": "sistemi.hr-core-app",
  "version": "1.0.0",
  "description": "Sistemi.hr Starterkit Core 2sxc app",
  "main": "(none)",
  "scripts": {
    "build-dev": "webpack --mode development",
    "build-prod": "webpack --mode production",
    "postinstall": "npm install copyfiles -g && npm run copy-markdown-it-js && npm run copy-moment-js && npm run copy-datetimemoment-js && npm run copy-datatables-files",
    "copy-markdown-it-js": "copyfiles -f node_modules/markdown-it/dist/markdown-it.min.js dist/markdown/",
    "copy-moment-js": "copyfiles -f node_modules/moment/min/moment.min.js dist/moment/",
    "copy-datetimemoment-js": "copyfiles -f node_modules/datatables.net-plugins/sorting/datetime-moment.js dist/moment/",
    "copy-datatables-files": "npm run copy-datatables-css && npm run copy-datatables-js",
    "copy-datatables-css": "copyfiles -f node_modules/datatables.net-bs5/css/dataTables.bootstrap5.min.css node_modules/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css dist/datatables/",
    "copy-datatables-js": "copyfiles -f node_modules/datatables.net/js/dataTables.min.js node_modules/datatables.net-bs5/js/dataTables.bootstrap5.min.js node_modules/datatables.net-buttons/js/dataTables.buttons.min.js node_modules/datatables.net-buttons-bs5/js/buttons.bootstrap5.min.js node_modules/datatables.net-buttons/js/buttons.html5.min.js dist/datatables/"
  },
  "repository": "https://github.com/netmedsis/sistemi-dnn-starterkit.git",
  "author": "Sistemi.hr",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@babel/preset-env": "^7.22.5",
    "autoprefixer": "^10.4.13",
    "babel-loader": "^9.1.2",
    "browser-sync": "^2.27.10",
    "browser-sync-webpack-plugin": "^2.3.0",
    "copyfiles": "^2.4.1",
    "css-loader": "^7.1.1",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "install": "^0.13.0",
    "mini-css-extract-plugin": "^2.9.2",
    "npm": "^11.2.0",
    "postcss-loader": "^8.1.1",
    "sass": "^1.75.0",
    "sass-loader": "^14.2.1",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "datatables.net": "^2.2.2",
    "datatables.net-bs5": "^2.2.2",
    "datatables.net-buttons": "^2.3.6",
    "datatables.net-buttons-bs5": "^2.3.6",
    "datatables.net-plugins": "2.2.2",
    "moment": "^2.30.1"
  }
}

