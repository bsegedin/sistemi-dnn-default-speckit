.c-search-overlay {
  display: block;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 99999;
  opacity: 1;
  transition: 0.15s ease-in opacity;
  background-color: rgba(10, 69, 127, 0.98);

  &__wrapper {
    width: 90%;
    margin: auto;
    @media (min-width: 992px) {
      width: 60%;
    }
  }

  .o-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: center;
    color: white;
    font-family: "changan uni type";
    font-weight: 300;
    @media (min-width: 992px) {
      font-size: 4rem;
      margin-bottom: 4rem; 
    }
  }

  .c-search-overlay__close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    cursor: pointer;
    @media (min-width: 992px) {
      right: 5rem;   
    }
    svg {
      stroke: white;
      fill: white;

      width: 32px;
    }
  }

  &__content {
    margin-top: 10rem;
  }


  .searchInputContainer {
    width: 100%;
    margin: 0;
    input {
      width: 100%;
      height: 48px;
      background-color: transparent;
      border: 0;outline: 0;
      border: 2px solid white;
      color: white;
      font-size: 1.5rem;
      padding: 2.5rem;
      border-radius: 50px;
      &:focus {
        border: 2px solid rgba(255, 255, 255, 0.98)
      }
    }
  }

  .c-search-form {
    position: relative;

    .c-search__icon {
      position: absolute;
      right: 2rem;
      top: 0;
      bottom: 0;
      margin: auto;
      display: flex;
      align-items: center;
      svg {
        fill: white;
      }

      &:hover {
        svg {
          fill: rgba(255, 255, 255, 0.7);
        }
      }
    }

    ::placeholder {
      color: white;
      opacity: 1;
      font-style: italic;
      font-weight: 300;
    }
    
    ::-ms-input-placeholder {
      color: white;
      font-style: italic;
      font-weight: 300;
    }

  }

  a.dnnSearchBoxClearText {
    top: 0;
    right: 100px;
    bottom: 0;
    margin: auto;
  }

  .searchSkinObjectPreview {
    left: 0;
    right: auto;
    width: 100%;
    margin-top: 1rem;
    background-color: transparent;
    color: white;
    border: 0;
    li {
      color: white;
      border-top: 0;
      border-bottom: 1px solid #c9c9c9;
      &.searchSkinObjectPreview_group {
        display: none;
        color: white;
        border: 0;
      }
      a.searchSkinObjectPreview_more {
        display: block;
        color: white;
        &:hover {
          text-decoration: none;
          color: $primary;
        }
      }
      a {
        color: white;
      }

      &:last-child {
        border-bottom: 0;
      }
    }
  }

}
