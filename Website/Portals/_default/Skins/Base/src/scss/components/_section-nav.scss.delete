.menu {
  position: relative;
  width: 100%;

  .sectionmenu-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  &.sticky {
    position:fixed;
    top:0;
    z-index: 9999;
    .navbar-brand {
      visibility: visible;
    }
  }

  .navbar-brand {
    visibility: hidden;
    max-width: 200px;
    img {
      filter: brightness(0) invert(1);
    }
  }

  // Menu

  .items {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;

    .item {
      position: relative;
      margin-left: 3.125rem;
      padding-top: 1rem;
      padding-bottom: 1rem;

      &:hover,
      &.active {
        a {
          &::before {
            background-color: white;
            content: "";
            position: absolute;
            top: auto;
            bottom: 0;
            left: 0;
            width: 100%;
            height: .5px;
            transform: none;
          }
        }
      }
      a {
        position: relative;
        display: block;
        color: white;
        text-decoration: none;
        font-size: 1.125rem;
        font-weight: 300;
      }
    }
  }

  .parent {
    margin-left: auto;
    text-transform: uppercase;
    font-weight: 700;
    font-size: 1.125rem;
    color: white;
    padding-top: 1.5rem;padding-bottom: 1.5rem;
  }

}
